# ---------------------------------------------------------------- Pflichtfelder
# Das Token, mit dem sich die ESP32-Terminals anmelden. Muss identisch in der
# Firmware (WLAN-Portal oder include/config.h) hinterlegt sein.
DEVICE_TOKEN=bitte-langes-zufaelliges-token-eintragen

# ------------------------------------------------------------------- Grundsetup
TZ=Europe/Berlin
HOUSEHOLD=Standard
LABEL_PREFIX=LEB
LABEL_PAPER_CHARS=32
LOG_LEVEL=INFO

# Passwortschutz fuer das Web-Interface (leer = offen im LAN). Anmeldung
# ueber /login, bleibt ein Jahr angemeldet. Ueber einen Reverse Proxy
# veroeffentlicht unbedingt setzen. UI_USER ist optional.
UI_PASSWORD=
# Schluessel fuer die Sprachsteuerung (Home Assistant, deploy/homeassistant/).
# Leer = es gilt die Anmeldung der Oberflaeche.
SPRACHE_TOKEN=
UI_USER=

# Optional: KI-Vorschlaege fuer neue Produkte (Kategorie, Sorte, Haltbarkeit je
# Lagerart) ueber die Claude API. Ohne Schluessel rechnet das MHD nur aus der
# Haltbarkeitstabelle der Kategorien. Gefragt wird nur mit Name und Marke.
ANTHROPIC_API_KEY=
# KI_MODEL=claude-opus-5-5

# --- Update-Knopf in der Weboberflaeche ------------------------------------
# Ein Container kann sein eigenes Abbild nicht ersetzen. Wer den Knopf will,
# richtet einen Dienst ein, der es darf (Watchtower) - fertige Vorlage in
# deploy/truenas/watchtower.yaml. Leer = der Knopf erklaert nur, was fehlt.
UPDATE_HOOK_URL=
UPDATE_HOOK_TOKEN=

# ------------------------------------------------------------------- Produktdaten
OPENFOODFACTS_ENABLED=true
HTTP_TIMEOUT=8

# --------------------------------------------------------------- MHD-Ueberwachung
EXPIRY_WARN_DAYS=3
EXPIRY_CHECK_HOUR=8
RESTORE_WINDOW_HOURS=48

# ------------------------------------------------------------ Benachrichtigungen
# ntfy
NTFY_URL=
NTFY_TOPIC=
# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# MQTT / Home Assistant
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=lebensmittel
