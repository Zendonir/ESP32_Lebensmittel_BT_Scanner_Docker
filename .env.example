# ---------------------------------------------------------------- Pflichtfelder
# Das Token, mit dem sich die ESP32-Terminals anmelden. Muss identisch in der
# Firmware (WLAN-Portal oder include/config.h) hinterlegt sein.
DEVICE_TOKEN=bitte-langes-zufaelliges-token-eintragen

# ------------------------------------------------------------------- Grundsetup
TZ=Europe/Berlin
HOUSEHOLD=Standard
LABEL_PREFIX=LEB
LABEL_PAPER_CHARS=32
LOG_LEVEL=INFO

# Optionaler Passwortschutz fuer das Web-Interface (leer = offen im LAN).
UI_PASSWORD=

# ------------------------------------------------------------------- Produktdaten
OPENFOODFACTS_ENABLED=true
HTTP_TIMEOUT=8

# --------------------------------------------------------------- MHD-Ueberwachung
EXPIRY_WARN_DAYS=3
EXPIRY_CHECK_HOUR=8
RESTORE_WINDOW_HOURS=48

# ------------------------------------------------------------ Benachrichtigungen
# ntfy
NTFY_URL=
NTFY_TOPIC=
# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# MQTT / Home Assistant
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=lebensmittel
